---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const navLinks = [
  { href: `${base}#inicio`, label: "Inicio" },
  { href: `${base}#quienes-somos`, label: "Quiénes Somos" },
  { href: `${base}#servicios`, label: "Servicios" },
  { href: `${base}#contacto`, label: "Contacto" },
];
---

<header id="site-header" class="sticky top-0 z-50 h-16 bg-brand sm:h-20">
  <div class="flex h-full items-stretch justify-between">
    <a
      href={`${base}#inicio`}
      class="ml-4 flex shrink-0 items-center gap-3 bg-white px-4 sm:gap-4 sm:px-6 md:ml-6 lg:ml-10"
      aria-label="Grupo Corporativo Aguilar — Ingeniería Perico, ir al inicio"
    >
      <img
        src={`${base}images/logo-grupo-aguilar.png`}
        alt="Grupo Corporativo Aguilar"
        class="h-8 w-auto sm:h-10"
        width="166"
        height="55"
      />
      <span class="h-8 w-px bg-slate-200 sm:h-10" aria-hidden="true"></span>
      <img
        src={`${base}images/logo-ingenieria-perico.png`}
        alt="Ingeniería Perico"
        class="h-8 w-auto sm:h-10"
        width="3412"
        height="1836"
      />
    </a>

    <div class="flex items-center gap-6 pr-4 sm:pr-6 lg:pr-8 xl:gap-8">
      <nav aria-label="Principal" class="hidden items-center gap-6 whitespace-nowrap text-sm font-medium lg:flex xl:gap-8">
        {navLinks.map((link) => (
          <a href={link.href} class="text-white/90 transition-colors hover:text-white">
            {link.label}
          </a>
        ))}
      </nav>

      <a
        href={`${base}#servicios`}
        class="hidden shrink-0 whitespace-nowrap bg-white px-5 py-2.5 text-sm font-semibold uppercase tracking-wide text-brand transition-colors hover:bg-white/90 lg:inline-block"
      >
        Conoce nuestros servicios
      </a>

      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center text-white lg:hidden"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Principal (móvil)"
    class="hidden flex-col gap-1 bg-white p-3 shadow-lg shadow-black/10 lg:hidden"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="px-4 py-3 text-base font-medium text-ink transition-colors hover:bg-slate-50"
      >
        {link.label}
      </a>
    ))}
    <a
      href={`${base}#servicios`}
      class="mt-1 bg-brand px-4 py-3 text-center text-base font-semibold uppercase tracking-wide text-white"
    >
      Conoce nuestros servicios
    </a>
  </nav>
</header>

<script>
  const menuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  menuButton?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("flex");
    mobileMenu?.classList.toggle("hidden");
    menuButton.setAttribute("aria-expanded", isOpen ? "true" : "false");
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.add("hidden");
      mobileMenu.classList.remove("flex");
      menuButton?.setAttribute("aria-expanded", "false");
    });
  });
</script>
