---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const navLinks = [
  { href: "#inicio", label: "Inicio" },
  { href: "#quienes-somos", label: "Quiénes Somos" },
  { href: "#servicios", label: "Servicios" },
  { href: "#contacto", label: "Contacto" },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-all duration-300"
  data-scrolled="false"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a
      href="#inicio"
      class="flex items-center gap-3 rounded-xl bg-white/95 px-3 py-2 shadow-sm shadow-black/5 backdrop-blur-sm sm:gap-4 sm:px-4"
      aria-label="Grupo Corporativo Aguilar — Ingeniería Perico, ir al inicio"
    >
      <img
        src={`${base}images/logo-grupo-aguilar.png`}
        alt="Grupo Corporativo Aguilar"
        class="h-7 w-auto sm:h-9"
        width="166"
        height="55"
      />
      <span class="h-7 w-px bg-slate-200 sm:h-9" aria-hidden="true"></span>
      <img
        src={`${base}images/logo-ingenieria-perico.png`}
        alt="Ingeniería Perico"
        class="h-7 w-auto sm:h-9"
        width="3412"
        height="1836"
      />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-6 whitespace-nowrap text-sm font-medium lg:flex xl:gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="nav-link text-white transition-colors [text-shadow:0_1px_3px_rgb(0_0_0_/_0.45)]"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href="#servicios"
      class="hidden shrink-0 whitespace-nowrap rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-transform hover:scale-105 lg:inline-block"
    >
      Conoce nuestros servicios
    </a>

    <button
      id="mobile-menu-button"
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/95 text-brand shadow-sm backdrop-blur-sm lg:hidden"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Principal (móvil)"
    class="mx-4 hidden flex-col gap-1 rounded-2xl bg-white p-3 shadow-lg shadow-black/10 lg:hidden"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="rounded-xl px-4 py-3 text-base font-medium text-ink transition-colors hover:bg-slate-50"
      >
        {link.label}
      </a>
    ))}
    <a
      href="#servicios"
      class="mt-1 rounded-xl bg-brand px-4 py-3 text-center text-base font-semibold text-white"
    >
      Conoce nuestros servicios
    </a>
  </nav>
</header>

<style>
  #site-header[data-scrolled="true"] {
    background-color: var(--color-surface);
    border-bottom-color: var(--color-border);
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
  }

  #site-header[data-scrolled="true"] .nav-link {
    color: var(--color-ink);
    text-shadow: none;
  }

  #site-header[data-scrolled="true"] .nav-link:hover {
    color: var(--color-brand);
  }

  #site-header:not([data-scrolled="true"]) .nav-link:hover {
    color: rgb(255 255 255 / 0.75);
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const menuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  const setScrolled = () => {
    if (!header) return;
    header.dataset.scrolled = window.scrollY > 40 ? "true" : "false";
  };
  setScrolled();
  window.addEventListener("scroll", setScrolled, { passive: true });

  menuButton?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("flex");
    mobileMenu?.classList.toggle("hidden");
    menuButton.setAttribute("aria-expanded", isOpen ? "true" : "false");
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.add("hidden");
      mobileMenu.classList.remove("flex");
      menuButton?.setAttribute("aria-expanded", "false");
    });
  });
</script>
