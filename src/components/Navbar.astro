---
const links = [
  { href: "#servicios", label: "Servicios" },
  { href: "#nosotros", label: "Nosotros" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-navy-950/60 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
    <a href="#" class="font-display text-lg font-semibold tracking-tight text-white">
      Grupo <span class="text-amber-500">Aguilar</span>
    </a>
    <ul class="hidden items-center gap-8 text-sm text-steel-300 md:flex">
      {links.map((link) => (
        <li>
          <a href={link.href} class="transition-colors hover:text-white">{link.label}</a>
        </li>
      ))}
    </ul>
    <a
      href="#contacto"
      class="hidden rounded-full bg-amber-500 px-5 py-2 text-sm font-medium text-navy-950 transition-transform hover:scale-105 md:inline-block"
    >
      Solicitar cotización
    </a>
  </nav>
</header>
