---
const services = [
  {
    title: "Ingeniería civil",
    description:
      "Diseño estructural, cálculo y supervisión de obra para edificaciones residenciales, comerciales e institucionales.",
  },
  {
    title: "Obra industrial",
    description:
      "Plantas de proceso, naves industriales y estructuras metálicas con estándares internacionales de seguridad.",
  },
  {
    title: "Consultoría técnica",
    description:
      "Estudios de factibilidad, gestión de proyectos y control de calidad en cada etapa de la construcción.",
  },
];
---

<section id="servicios" class="relative bg-navy-950 px-6 py-28 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="font-display text-sm font-medium uppercase tracking-[0.3em] text-amber-400">Servicios</p>
      <h2 class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl">
        Soluciones de ingeniería de principio a fin
      </h2>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-3">
      {services.map((service) => (
        <div class="reveal rounded-2xl border border-white/10 bg-navy-900/60 p-8 transition-colors hover:border-amber-500/40">
          <h3 class="font-display text-xl font-semibold text-white">{service.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-steel-300">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
