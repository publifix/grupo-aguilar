---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<section
  id="inicio"
  class="relative h-[calc(100svh-4rem)] min-h-[520px] w-full overflow-hidden bg-brand-ink sm:h-[calc(100svh-5rem)]"
>
  <img
    src={`${base}images/hero/grupo-aguilar-hero.webp`}
    srcset={`${base}images/hero/grupo-aguilar-hero-mobile.webp 900w, ${base}images/hero/grupo-aguilar-hero.webp 2000w`}
    sizes="100vw"
    alt="Vista aérea de una obra de urbanización de Grupo Corporativo Aguilar con personal de campo supervisando la construcción"
    class="absolute inset-0 h-full w-full object-cover"
    fetchpriority="high"
    loading="eager"
    width="1792"
    height="1008"
  />

  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-brand-ink/95 via-brand-ink/50 to-transparent"></div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-brand-ink/70 via-transparent to-transparent"></div>

  <div class="relative z-10 flex h-full items-end">
    <div class="max-w-2xl px-6 pb-14 sm:px-8 sm:pb-20 lg:px-12 lg:pb-24">
      <h1 class="reveal-item font-display text-[clamp(2.25rem,6vw,4.5rem)] font-bold leading-[1.05] text-white">
        Grupo Corporativo Aguilar
      </h1>
      <p class="reveal-item mt-5 max-w-xl text-[clamp(1rem,1.6vw,1.25rem)] text-white/85">
        Ingeniería eléctrica, infraestructura y desarrollo inmobiliario del más alto nivel —
        con Ingeniería Perico y AGCA.
      </p>
      <div class="reveal-item mt-8 flex flex-wrap items-center gap-4">
        <a
          href={`${base}#empresas`}
          class="inline-block bg-white px-7 py-3.5 text-sm font-semibold uppercase tracking-wide text-brand transition-colors hover:bg-white/90"
        >
          Nuestras Empresas
        </a>
        <a
          href={`${base}#contacto`}
          class="inline-block border border-white px-7 py-3.5 text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:bg-white/10"
        >
          Contacto
        </a>
      </div>
    </div>
  </div>
</section>
