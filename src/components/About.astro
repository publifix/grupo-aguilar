---
const stats = [
  { value: "20+", label: "años de experiencia" },
  { value: "150+", label: "proyectos entregados" },
  { value: "98%", label: "clientes que repiten" },
];
---

<section id="nosotros" class="relative bg-navy-900/40 px-6 py-28 lg:px-8">
  <div class="mx-auto grid max-w-7xl gap-16 lg:grid-cols-2 lg:items-center">
    <div class="reveal">
      <p class="font-display text-sm font-medium uppercase tracking-[0.3em] text-amber-400">Nosotros</p>
      <h2 class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl">
        Ingeniería con precisión y respaldo técnico
      </h2>
      <p class="mt-6 text-steel-300">
        En Grupo Aguilar combinamos experiencia de campo con procesos de ingeniería rigurosos
        para entregar obras seguras, eficientes y dentro de tiempo. Nuestro equipo acompaña
        cada proyecto desde el diseño conceptual hasta la puesta en marcha.
      </p>
    </div>

    <div class="reveal grid grid-cols-3 gap-6">
      {stats.map((stat) => (
        <div class="rounded-2xl border border-white/10 bg-navy-900/60 p-6 text-center">
          <p class="font-display text-3xl font-semibold text-amber-400">{stat.value}</p>
          <p class="mt-2 text-xs uppercase tracking-wide text-steel-400">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
