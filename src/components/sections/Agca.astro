---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const projects = [
  "Punta Tiburón",
  "Dos Riberas",
  "Lagos de Puente Moreno",
  "Nuevo Veracruz · Tabachines I y II",
  "Infonavit Tejería",
  "Condominios Valdrada",
];
---

<section id="agca" class="bg-agca-dark px-6 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <div class="reveal-item inline-flex rounded-2xl bg-white px-6 py-4 sm:px-8 sm:py-5">
      <img
        src={`${base}images/empresas/agca.jpg`}
        alt="Logotipo de Desarrollo Inmobiliario AGCA"
        class="h-10 w-auto object-contain sm:h-12"
        loading="lazy"
      />
    </div>

    <p class="reveal-item mt-8 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-agca-accent">
      <span aria-hidden="true">—</span> AGCA · Desarrollo Inmobiliario
    </p>
    <h2 class="reveal-item mt-4 max-w-3xl font-display text-[clamp(2.25rem,5vw,3.75rem)] font-bold leading-[1.05] text-white">
      Comunidades y espacios pensados para crecer.
    </h2>
    <p class="reveal-item mt-5 max-w-2xl text-lg leading-relaxed text-white/70">
      El brazo inmobiliario de Grupo Aguilar: fraccionamientos, plazas y edificación vertical,
      desarrollados con el mismo respaldo técnico e ingeniería propia que sostiene a Ingeniería
      Perico.
    </p>

    <div class="mt-16 grid gap-8 lg:grid-cols-5 lg:gap-10">
      <div class="reveal-item group relative overflow-hidden rounded-[24px] lg:col-span-2">
        <img
          src={`${base}images/agca/agca-desarrollo-principal.jpg`}
          alt="Vista aérea de un desarrollo residencial de AGCA con torres, lago artificial y áreas verdes"
          loading="lazy"
          class="aspect-[3/4] w-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
        />
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/55 to-transparent"></div>
      </div>

      <div class="reveal-item lg:col-span-3">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {projects.map((project) => (
            <div class="project-pill flex items-center gap-3 rounded-2xl bg-agca-card px-5 py-4">
              <span class="pill-dot h-2 w-2 shrink-0 rounded-full bg-agca-accent" aria-hidden="true"></span>
              <span class="text-sm font-medium text-white sm:text-base">{project}</span>
            </div>
          ))}
        </div>

        <a
          href={`${base}#contacto`}
          class="mt-8 inline-flex items-center gap-1.5 text-sm font-semibold text-agca-accent transition-colors duration-300 ease-out hover:text-white"
        >
          Conoce más sobre AGCA
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .project-pill {
    transition: background-color 300ms ease-out;
  }

  .project-pill:hover {
    background-color: #474c6e;
  }

  .pill-dot {
    transition: transform 300ms ease-out;
  }

  .project-pill:hover .pill-dot {
    transform: scale(1.3);
  }
</style>
