---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

interface Project {
  name: string;
  image: string;
  alt: string;
}

// Clicking a project swaps the clubhouse photo above for that project's
// own photo. Condominios Valdrada has no dedicated photo yet, so it
// falls back to the Punta Tiburón clubhouse shot rather than a broken
// image.
const projects: Project[] = [
  {
    name: "Punta Tiburón",
    image: "agca-club-house.webp",
    alt: "Casa club de Punta Tiburón con alberca y vista al desarrollo de AGCA",
  },
  {
    name: "Dos Riberas",
    image: "agca-dos-riberas.webp",
    alt: "Vista aérea del desarrollo residencial Dos Riberas de AGCA",
  },
  {
    name: "Lagos de Puente Moreno",
    image: "agca-lagos-puente-moreno.webp",
    alt: "Vista aérea del fraccionamiento Lagos de Puente Moreno de AGCA, con laguna y albercas",
  },
  {
    name: "Nuevo Veracruz",
    image: "agca-nuevo-veracruz.webp",
    alt: "Vista aérea del desarrollo Nuevo Veracruz de AGCA",
  },
  {
    name: "Infonavit",
    image: "agca-infonavit.webp",
    alt: "Render aéreo del desarrollo Infonavit Tejería de AGCA",
  },
  {
    name: "Condominios Valdrada",
    image: "agca-club-house.webp",
    alt: "Casa club de Punta Tiburón con alberca y vista al desarrollo de AGCA",
  },
];
---

<section id="agca" class="relative overflow-hidden px-6 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28">
  <img
    src={`${base}images/agca/agca-seccion-hero.webp`}
    srcset={`${base}images/agca/agca-seccion-hero-mobile.webp 900w, ${base}images/agca/agca-seccion-hero.webp 1600w`}
    sizes="100vw"
    alt="Vista aérea del desarrollo Punta Tiburón, con campo de golf, laguna y residencias de AGCA"
    class="absolute inset-0 h-full w-full object-cover"
    loading="lazy"
  />
  <div class="pointer-events-none absolute inset-0 bg-agca-dark/75"></div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-agca-dark/90 via-agca-dark/50 to-transparent"></div>

  <div class="relative mx-auto max-w-7xl lg:text-center">
    <div class="reveal-item inline-flex rounded-2xl bg-white px-6 py-4 sm:px-8 sm:py-5 lg:flex lg:w-fit lg:mx-auto">
      <img
        src={`${base}images/empresas/agca.jpg`}
        alt="Logotipo de Desarrollo Inmobiliario AGCA"
        class="h-10 w-auto object-contain sm:h-12"
        loading="lazy"
      />
    </div>

    <p class="reveal-item mt-8 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-agca-accent lg:justify-center">
      <span aria-hidden="true">—</span> AGCA · Desarrollo Inmobiliario
    </p>
    <h2 class="reveal-item mt-4 max-w-3xl font-display text-[clamp(2.25rem,5vw,3.75rem)] font-bold leading-[1.05] text-white lg:mx-auto">
      Comunidades y espacios pensados para crecer.
    </h2>
    <p class="reveal-item mt-5 max-w-2xl text-lg leading-relaxed text-white/70 lg:mx-auto">
      El brazo inmobiliario de Grupo Aguilar: fraccionamientos, plazas y edificación vertical,
      desarrollados con el mismo respaldo técnico e ingeniería propia que sostiene a Ingeniería
      Perico.
    </p>

    <div class="reveal-item mt-8 hidden lg:block lg:mx-auto lg:max-w-3xl">
      <img
        id="agca-project-photo"
        src={`${base}images/agca/${projects[0].image}`}
        alt={projects[0].alt}
        loading="lazy"
        class="aspect-[21/9] w-full rounded-[24px] object-cover transition-opacity duration-200 ease-out"
      />
    </div>

    <div class="reveal-item mt-16 lg:mx-auto lg:max-w-3xl">
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {projects.map((project, i) => (
          <button
            type="button"
            class="project-pill flex w-full items-center gap-3 rounded-2xl bg-agca-card px-5 py-4 text-left"
            data-image={`${base}images/agca/${project.image}`}
            data-alt={project.alt}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            <span class="pill-dot h-2 w-2 shrink-0 rounded-full bg-agca-accent" aria-hidden="true"></span>
            <span class="text-sm font-medium text-white sm:text-base">{project.name}</span>
          </button>
        ))}
      </div>

      <div class="mt-8 lg:flex lg:justify-center">
        <a
          href={`${base}#contacto`}
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-agca-accent transition-colors duration-300 ease-out hover:text-white"
        >
          Conoce más sobre AGCA
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .project-pill {
    cursor: pointer;
    transition: background-color 300ms ease-out;
  }

  .project-pill:hover,
  .project-pill[aria-pressed="true"] {
    background-color: #474c6e;
  }

  .pill-dot {
    transition: transform 300ms ease-out;
  }

  .project-pill:hover .pill-dot,
  .project-pill[aria-pressed="true"] .pill-dot {
    transform: scale(1.3);
  }
</style>

<script>
  const photo = document.getElementById("agca-project-photo") as HTMLImageElement | null;
  const pills = document.querySelectorAll<HTMLButtonElement>(".project-pill");

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      const image = pill.dataset.image;
      const alt = pill.dataset.alt ?? "";
      if (!photo || !image || photo.getAttribute("src") === image) return;

      photo.style.opacity = "0";
      window.setTimeout(() => {
        photo.setAttribute("src", image);
        photo.setAttribute("alt", alt);
        photo.style.opacity = "1";
      }, 200);

      pills.forEach((p) => p.setAttribute("aria-pressed", "false"));
      pill.setAttribute("aria-pressed", "true");
    });
  });
</script>
