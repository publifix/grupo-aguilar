---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const stats = [
  { value: "50", label: "Años de trayectoria", id: undefined },
  { value: "350+", label: "Proyectos entregados", id: undefined },
  { value: "ISO 9001:2015", label: "Certificación de calidad", id: "certificacion", badge: true },
  { value: "5", label: "Empresas del grupo", id: undefined },
];
---

<section id="quienes-somos" class="bg-surface px-6 py-20 sm:px-8 sm:py-24 lg:px-12">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <h2 class="font-display text-[clamp(2.25rem,5vw,3.75rem)] font-bold leading-[1.05] text-brand">
        Ingeniería que construye el futuro de Veracruz.
      </h2>
      <p class="text-lg leading-relaxed text-muted lg:pt-2">
        Grupo Aguilar es una empresa constituida en Veracruz, con el propósito de brindar
        servicios de ingeniería de alta calidad. Somos especialistas en la Proyección,
        Construcción y Dirección de obra electromecánica y de urbanización. Nuestro personal
        está capacitado para desarrollar con profesionalismo, calidad, y eficiencia proyectos
        industriales y urbanísticos, siempre contando con estrictas normas de seguridad y
        cuidado al medio ambiente.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-4 sm:mt-16 lg:grid-cols-4 lg:gap-6">
      {stats.map((stat) => (
        <div
          id={stat.id}
          class="reveal-item flex flex-col justify-between border border-panel-border bg-panel p-6 sm:p-7 transition-colors hover:border-brand/40"
        >
          <div>
            {stat.badge && (
              <svg xmlns="http://www.w3.org/2000/svg" class="mb-3 h-8 w-8 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
            <p class={`font-display font-bold text-brand ${stat.badge ? "text-2xl sm:text-3xl" : "text-4xl sm:text-5xl"}`}>
              {stat.value}
            </p>
            <p class="mt-2 text-sm text-muted">{stat.label}</p>
          </div>
          <a
            href="#empresas"
            class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand transition-colors hover:text-brand-deep"
          >
            Conócenos
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
