---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const stats = [
  { value: "+40", label: "Años de trayectoria", id: undefined, icon: undefined },
  {
    text: "Obras de Infraestructura en México y el extranjero",
    id: undefined,
    icon: "globe",
  },
  { value: "ISO 9001:2015", label: "Certificación de calidad", id: "certificacion", icon: "check" },
  { value: "2", label: "Empresas en el grupo", id: undefined, icon: undefined },
];
---

<section id="quienes-somos" class="bg-surface px-6 py-20 sm:px-8 sm:py-24 lg:px-12">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <h2 class="font-display text-[clamp(2.25rem,5vw,3.75rem)] font-bold leading-[1.05] text-brand">
        Ingeniería y desarrollo, bajo un mismo techo.
      </h2>
      <p class="text-lg leading-relaxed text-muted lg:pt-2">
        Grupo Aguilar es una empresa constituida en Veracruz, con el propósito de brindar
        servicios de ingeniería de alta calidad. Somos especialistas en la Proyección,
        Construcción y Dirección de obra electromecánica y de urbanización. Nuestro personal
        está capacitado para desarrollar con profesionalismo, calidad, y eficiencia proyectos
        industriales y urbanísticos, siempre contando con estrictas normas de seguridad y
        cuidado al medio ambiente.
      </p>
    </div>

    <div id="stat-cards" class="mt-14 grid grid-cols-2 gap-4 sm:mt-16 lg:grid-cols-4 lg:gap-6">
      {stats.map((stat) => (
        <div
          id={stat.id}
          class="stat-card border border-panel-border bg-panel p-6 sm:p-7"
        >
          {stat.icon === "check" && (
            <svg xmlns="http://www.w3.org/2000/svg" class="mb-3 h-8 w-8 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          )}
          {stat.icon === "globe" && (
            <svg xmlns="http://www.w3.org/2000/svg" class="mb-3 h-8 w-8 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zM3.6 9h16.8M3.6 15h16.8M12 3a13.5 13.5 0 010 18 13.5 13.5 0 010-18z" />
            </svg>
          )}
          {stat.value && (
            <p class="font-display text-4xl font-bold text-brand sm:text-5xl">{stat.value}</p>
          )}
          {stat.label && <p class="mt-2 text-sm text-muted">{stat.label}</p>}
          {stat.text && <p class="text-lg font-semibold leading-snug text-brand">{stat.text}</p>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stat-card {
    opacity: 0;
    transform: translateY(28px) scale(0.94);
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-card {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const cards = gsap.utils.toArray<HTMLElement>("#stat-cards .stat-card");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (cards.length && !reduceMotion) {
    ScrollTrigger.batch(cards, {
      start: "top 88%",
      once: true,
      onEnter: (batch) =>
        gsap.to(batch, {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.65,
          stagger: 0.12,
          ease: "back.out(1.6)",
        }),
    });
  } else if (cards.length) {
    gsap.set(cards, { opacity: 1, y: 0, scale: 1 });
  }
</script>
