---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

interface Project {
  number: string;
  image: string;
  imageAlt: string;
  meta: string;
  title: string;
  description: string;
}

const projects: Project[] = [
  {
    number: "01",
    image: `${base}images/proyectos/proyecto-destacado-refineria-olmeca.webp`,
    imageAlt: "Vista aérea de las torres de destilación de la Refinería Olmeca al atardecer",
    meta: "Paraíso, Tabasco · Para IDINSA",
    title: "Refinería Olmeca",
    description: "Troncal eléctrico en media tensión, red de tierras, tanques y sistema contra incendio.",
  },
  {
    number: "02",
    image: `${base}images/proyectos/proyecto-destacado-ciudad-hospitalaria.webp`,
    imageAlt: "Vista aérea del complejo de Ciudad Hospitalaria",
    meta: "Panamá · FCC-Carso",
    title: "Ciudad Hospitalaria",
    description: "Instalaciones eléctricas, hidráulicas y sanitarias; ductos de aire acondicionado y VRF.",
  },
  {
    number: "03",
    image: `${base}images/proyectos/proyecto-destacado-nestle-mexico.webp`,
    imageAlt: "Planta industrial de Nestlé México con silos de acero inoxidable",
    meta: "Planta Veracruz",
    title: "Nestlé México",
    description: "Construcción de troncal eléctrico en media tensión y obras asociadas para la operación industrial.",
  },
  {
    number: "04",
    image: `${base}images/proyectos/proyecto-destacado-cice.webp`,
    imageAlt: "Vista aérea de las instalaciones portuarias de CICE",
    meta: "Sector portuario",
    title: "CICE",
    description: "Desarrollo de instalaciones de red de media y baja tensión, CCTV, voz y datos.",
  },
  {
    number: "05",
    image: `${base}images/proyectos/proyecto-destacado-star-medica.webp`,
    imageAlt: "Render de la torre hospitalaria de Star Médica",
    meta: "Sector salud",
    title: "Star Médica",
    description: "Instalaciones hidrosanitarias y eléctricas para la construcción de la torre hospitalaria.",
  },
  {
    number: "06",
    image: `${base}images/proyectos/proyecto-destacado-constellation-brands.webp`,
    imageAlt: "Planta de producción de Constellation Brands",
    meta: "Planta Veracruz",
    title: "Constellation Brands",
    description: "Instalaciones eléctricas para el Rack Power Lighting y el Railway Power Lighting en la planta de Veracruz.",
  },
];
---

<section id="proyectos-destacados" class="bg-surface px-6 py-20 sm:px-8 sm:py-24 lg:px-12">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center">
      <p class="reveal-item flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-brand">
        <span aria-hidden="true">—</span> Experiencia destacada
      </p>
      <h2 class="reveal-item mt-4 font-display text-[clamp(2.25rem,5vw,3.75rem)] font-bold leading-[1.05] text-brand">
        Proyectos que hablan por nosotros.
      </h2>
      <p class="reveal-item mt-4 text-lg text-muted">
        Una muestra de la obra ejecutada por Grupo Aguilar, entre ingeniería electromecánica y desarrollo urbano.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {projects.map((project) => (
        <article class="reveal-item overflow-hidden rounded-[24px] bg-white shadow-lg shadow-brand-ink/5">
          <div class="relative aspect-[4/3] overflow-hidden">
            <img
              src={project.image}
              alt={project.imageAlt}
              class="h-full w-full object-cover"
              loading="lazy"
            />
            <span class="absolute left-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-brand-ink/60 text-sm font-semibold text-white">
              {project.number}
            </span>
          </div>
          <div class="p-8 sm:p-10">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">{project.meta}</p>
            <h3 class="mt-2 font-display text-2xl font-bold text-ink sm:text-3xl">{project.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{project.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
