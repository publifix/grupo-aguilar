---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const categories = [
  {
    title: "Proyectos Eléctricos",
    description: "Diseño eléctrico industrial, comercial y residencial, proyectos integrales NOM y trámites ante CFE/UVIE.",
    image: `${base}images/proyectos/proyecto-instalacion-electrica.jpg`,
    alt: "Ingeniero de Perico revisando un tablero eléctrico durante un proyecto industrial en Veracruz",
  },
  {
    title: "Alumbrado y Sistemas Inteligentes",
    description: "Diseño, construcción y mantenimiento de alumbrado público y sistemas inteligentes de iluminación.",
    image: `${base}images/proyectos/proyecto-obra-urbanizacion-aerea.jpg`,
    alt: "Vista aérea de una obra de urbanización con instalación de infraestructura de alumbrado",
  },
  {
    title: "Instalaciones y Mantenimiento",
    description: "Construcción y mantenimiento civil/electromecánico en baja, media y alta tensión, plantas de emergencia y tableros de transferencia.",
    image: `${base}images/proyectos/proyecto-personal-campo.jpg`,
    alt: "Personal técnico de Grupo Aguilar en campo durante labores de mantenimiento",
  },
  {
    title: "Obra Civil, Mecánica y Estructural",
    description: "Proyecto y ejecución de obra civil, mecánica y estructural, incluyendo montaje de equipo industrial.",
    image: `${base}images/proyectos/proyecto-obra-urbanizacion-aerea.jpg`,
    alt: "Obra civil y estructural en ejecución vista desde altura",
  },
  {
    title: "Estudios y Pruebas Especializadas",
    description: "Estudios de código de red y eficiencia energética con ETAP, pruebas Megger, Hipot, VLF, TTR y asesoría especializada.",
    image: `${base}images/proyectos/proyecto-planeacion-topografica.jpg`,
    alt: "Ingenieros de Grupo Aguilar analizando planos técnicos de un estudio especializado",
  },
  {
    title: "Urbanización",
    description: "Proyectos de electrificación, drenaje, agua potable y pluvial para desarrollos urbanos.",
    image: `${base}images/proyectos/proyecto-obra-urbanizacion-aerea.jpg`,
    alt: "Obra de urbanización con instalación de drenaje y redes de agua potable",
  },
];
---

<section id="servicios" class="bg-surface px-6 py-20 sm:px-8 sm:py-24 lg:px-12">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-2xl">
      <h2 class="font-display text-[clamp(2rem,4.5vw,3.25rem)] font-bold leading-[1.05] text-brand">
        Servicios de ingeniería integral.
      </h2>
      <p class="mt-4 text-lg text-muted">
        De la proyección eléctrica a la urbanización, cubrimos cada etapa de tu proyecto.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((cat) => (
        <article class="reveal-item group border border-panel-border transition-colors hover:border-brand/40">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src={cat.image}
              alt={cat.alt}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="p-6">
            <h3 class="font-display text-xl font-bold text-ink">{cat.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{cat.description}</p>
            <a
              href="#contacto"
              class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand transition-colors hover:text-brand-deep"
            >
              Ver más
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-14 text-center text-sm font-semibold uppercase tracking-wide text-muted">
      Seguimos estrictamente las normas de seguridad y cuidado al medio ambiente.
    </p>
  </div>
</section>
