---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

interface Client {
  name: string;
  slug: string;
  featured?: boolean;
}

// Ordered by prominence: government bodies and large corporates first,
// down to smaller-scale residential developments — per the client's
// explicit priority order, not alphabetical or by upload date.
const clients: Client[] = [
  { name: "CFE", slug: "cfe", featured: true },
  { name: "Pemex", slug: "pemex", featured: true },
  { name: "Nissan", slug: "nissan", featured: true },
  { name: "Nestlé", slug: "nestle", featured: true },
  { name: "Tenaris Tamsa", slug: "tenaris-tamsa", featured: true },
  { name: "FCC", slug: "fcc", featured: true },
  { name: "Carso", slug: "carso", featured: true },

  { name: "Golmex", slug: "golmex" },
  { name: "SCT", slug: "sct" },
  { name: "IMT", slug: "imt" },
  { name: "Gobierno del Estado de Veracruz", slug: "gobierno-veracruz" },
  { name: "Municipio de Boca del Río", slug: "municipio-boca-del-rio" },
  { name: "Gobierno Municipal de Veracruz", slug: "gobierno-municipal-veracruz" },
  { name: "Bredero Shaw", slug: "bredero-shaw" },

  { name: "Hubard y Bourlon", slug: "hubard-y-bourlon" },
  { name: "Consorcio Hogar", slug: "consorcio-hogar" },
  { name: "Grupo Piro", slug: "grupo-piro" },
  { name: "GIA", slug: "gia" },
  { name: "ISISA", slug: "isisa" },
  { name: "Casas Carpin", slug: "casas-carpin" },
  { name: "Casas Díaz", slug: "casas-diaz" },

  { name: "Ximara Residencial", slug: "ximara" },
  { name: "Privanzas", slug: "privanzas" },
  { name: "Punta Tiburón Residencial, Marina & Golf", slug: "punta-tiburon" },
  { name: "Dos Riberas Residencial & Club de Golf", slug: "dos-riberas" },
  { name: "Lagos de Puente Moreno", slug: "lagos-puente-moreno" },
  { name: "Residencial Del Bosque", slug: "residencial-del-bosque" },
  { name: "CSI", slug: "csi" },
];

// Hand-sequenced (not a rigid A-B-C repeat) so the three accent colors —
// institutional blue, Perico green, AGCA magenta — feel varied rather
// than patterned, with no two adjacent pills sharing a color.
const accentSequence = [
  "brand", "agca", "perico", "brand", "perico", "agca", "brand",
  "agca", "brand", "perico", "agca", "brand", "perico", "brand",
  "perico", "agca", "brand", "perico", "brand", "agca", "perico",
  "brand", "perico", "agca", "brand", "agca", "perico", "agca",
] as const;

const accentVars: Record<(typeof accentSequence)[number], string> = {
  brand: "var(--color-brand)",
  perico: "var(--color-perico-accent)",
  agca: "var(--color-agca-accent)",
};
---

<section id="clientes" class="bg-brand-tint px-6 py-20 sm:px-8 sm:py-24 lg:px-12">
  <div class="mx-auto max-w-3xl text-center">
    <p class="reveal-item flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-perico-accent">
      <span aria-hidden="true">—</span> Confianza y Trayectoria
    </p>
    <h2 class="reveal-item mx-auto mt-4 font-display text-[clamp(2rem,4.5vw,3.25rem)] font-bold leading-[1.05] text-brand">
      Empresas e instituciones que ya confiaron en nosotros.
    </h2>
  </div>

  <div class="reveal-item mx-auto mt-14 flex max-w-6xl flex-wrap justify-center gap-3 sm:gap-4">
    {clients.map((client, i) => (
      <div
        class={`client-pill flex items-center justify-center rounded-full border-2 bg-panel ${client.featured ? "px-7 py-4" : "px-5 py-3"}`}
        style={`--pill-color: ${accentVars[accentSequence[i]]}`}
      >
        <img
          src={`${base}images/clientes/${client.slug}.png`}
          alt={`Logotipo de ${client.name}`}
          loading="lazy"
          class={`w-auto object-contain ${client.featured ? "h-9 max-w-[150px] sm:h-10" : "h-7 max-w-[120px] sm:h-8"}`}
        />
      </div>
    ))}
  </div>
</section>

<style>
  .client-pill {
    border-color: color-mix(in srgb, var(--pill-color) 45%, white);
    transition: border-color 300ms ease-out, transform 300ms ease-out, box-shadow 300ms ease-out;
  }

  .client-pill:hover {
    border-color: var(--pill-color);
    transform: translateY(-3px);
    box-shadow: 0 10px 20px -8px rgb(0 0 0 / 0.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .client-pill:hover {
      transform: none;
    }
  }
</style>
