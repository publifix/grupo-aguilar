---
const whatsappPath =
  "M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.85.5 3.62 1.44 5.19L2 22l5.03-1.55a9.9 9.9 0 004.97 1.35h.01c5.46 0 9.9-4.45 9.9-9.91C21.91 6.45 17.5 2 12.04 2m0 18.13a8.2 8.2 0 01-4.19-1.15l-.3-.18-3.1.96.98-3.02-.2-.31a8.16 8.16 0 01-1.26-4.36c0-4.52 3.68-8.2 8.2-8.2 4.52 0 8.2 3.68 8.2 8.2s-3.68 8.06-8.33 8.06m4.5-6.13c-.25-.12-1.45-.72-1.67-.8-.22-.08-.39-.12-.55.12-.16.25-.63.8-.78.96-.14.16-.29.18-.53.06-.25-.12-1.04-.38-1.98-1.22a7.4 7.4 0 01-1.37-1.7c-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.55-1.32-.75-1.81-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.65.31-.22.25-.86.84-.86 2.04 0 1.2.88 2.37 1 2.53.12.16 1.72 2.63 4.17 3.68.58.25 1.04.4 1.39.51.59.19 1.12.16 1.54.1.47-.07 1.45-.59 1.65-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.47-.28";

const companyDetails = [
  { label: "Razón social", value: "Grupo Corporativo Aguilar", href: undefined },
  {
    label: "Dirección",
    value: "Francisco J. Mina 191, Col. Ricardo Flores Magón, Veracruz, Ver. · C.P. 91900",
    href: undefined,
  },
  { label: "Teléfono", value: "(229) 202 0532 al 35", href: "tel:+522292020532" },
  { label: "Correo", value: "perico@grupoaguilar.com.mx", href: "mailto:perico@grupoaguilar.com.mx" },
  { label: "Sitio", value: "www.grupoaguilar.com.mx", href: "https://www.grupoaguilar.com.mx" },
];
---

<section id="contacto" class="bg-agca-dark px-6 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="reveal-item">
        <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-perico-accent">
          <span aria-hidden="true">—</span> Contacto
        </p>
        <h2 class="mt-4 font-display text-[clamp(2.25rem,5vw,3.75rem)] font-bold leading-[1.05] text-white">
          Cuéntanos sobre tu proyecto.
        </h2>
        <p class="mt-5 max-w-lg text-lg leading-relaxed text-white/70">
          Ya sea ingeniería con Perico o desarrollo con AGCA, un especialista de Grupo Aguilar te
          contactará con los siguientes pasos.
        </p>

        <a
          href="https://wa.me/5212291614806"
          target="_blank"
          rel="noopener noreferrer"
          class="whatsapp-btn mt-8 inline-flex items-center gap-3 rounded-full px-7 py-4 text-sm font-semibold text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={whatsappPath} />
          </svg>
          Escríbenos por WhatsApp
        </a>

        <a
          href="mailto:perico@grupoaguilar.com.mx"
          class="mt-5 flex w-fit items-center gap-2.5 text-sm font-medium text-white/80 transition-colors duration-300 ease-out hover:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0-.83.67-1.5 1.5-1.5h16.5c.83 0 1.5.67 1.5 1.5v10.5c0 .83-.67 1.5-1.5 1.5H3.75c-.83 0-1.5-.67-1.5-1.5V6.75z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 7.5l9.75 6.5 9.75-6.5" />
          </svg>
          perico@grupoaguilar.com.mx
        </a>
      </div>

      <div class="reveal-item rounded-[24px] bg-agca-card p-8 sm:p-10">
        {companyDetails.map((detail) => (
          <div class="border-b border-white/10 py-5 first:pt-0 last:border-0 last:pb-0">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/50">{detail.label}</p>
            {detail.href ? (
              <a
                href={detail.href}
                target={detail.href.startsWith("http") ? "_blank" : undefined}
                rel={detail.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="mt-2 block text-white transition-colors duration-300 ease-out hover:text-perico-accent"
              >
                {detail.value}
              </a>
            ) : (
              <p class="mt-2 text-white">{detail.value}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .whatsapp-btn {
    background: linear-gradient(135deg, #25d366, #128c7e);
    transition: filter 300ms ease-out;
  }

  .whatsapp-btn:hover {
    filter: brightness(0.9);
  }
</style>
