---

<section id="contacto" class="bg-surface px-6 py-20 sm:px-8 sm:py-24 lg:px-12">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-2xl">
      <h2 class="font-display text-[clamp(2rem,4.5vw,3.25rem)] font-bold leading-[1.05] text-brand">
        Hablemos de tu proyecto.
      </h2>
      <p class="mt-4 text-lg text-muted">
        Cuéntanos qué necesitas y un ingeniero de nuestro equipo te contactará a la brevedad.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
      <form id="contact-form" novalidate class="space-y-5" aria-describedby="form-status">
        <div>
          <label for="name" class="block text-sm font-semibold text-ink">Nombre completo</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            class="mt-2 w-full border border-panel-border bg-white px-4 py-3 text-ink outline-none transition-colors focus:border-brand"
            aria-describedby="name-error"
          />
          <p id="name-error" role="alert" class="mt-1.5 hidden text-sm text-red-600"></p>
        </div>

        <div>
          <label for="phone" class="block text-sm font-semibold text-ink">Teléfono</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            autocomplete="tel"
            class="mt-2 w-full border border-panel-border bg-white px-4 py-3 text-ink outline-none transition-colors focus:border-brand"
            aria-describedby="phone-error"
          />
          <p id="phone-error" role="alert" class="mt-1.5 hidden text-sm text-red-600"></p>
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold text-ink">Correo</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="mt-2 w-full border border-panel-border bg-white px-4 py-3 text-ink outline-none transition-colors focus:border-brand"
            aria-describedby="email-error"
          />
          <p id="email-error" role="alert" class="mt-1.5 hidden text-sm text-red-600"></p>
        </div>

        <div>
          <label for="message" class="block text-sm font-semibold text-ink">Mensaje</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="mt-2 w-full resize-none border border-panel-border bg-white px-4 py-3 text-ink outline-none transition-colors focus:border-brand"
            aria-describedby="message-error"
          ></textarea>
          <p id="message-error" role="alert" class="mt-1.5 hidden text-sm text-red-600"></p>
        </div>

        <button
          type="submit"
          id="form-submit"
          class="inline-flex items-center gap-2 bg-brand px-8 py-3.5 text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:bg-brand-deep disabled:opacity-60"
        >
          Enviar
        </button>

        <p id="form-status" role="status" aria-live="polite" class="text-sm text-muted"></p>
      </form>

      <div class="space-y-8">
        <div class="space-y-4 text-ink">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-muted">Dirección</p>
            <p class="mt-1">Francisco J. Mina 191, Col. R. Flores Magón, Veracruz, Ver. CP. 91900</p>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-muted">Teléfono</p>
            <a href="tel:+522292020532" class="mt-1 block transition-colors hover:text-brand">(229) 202 0532 al 35</a>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-muted">Correo</p>
            <a href="mailto:perico@grupoaguilar.com.mx" class="mt-1 block transition-colors hover:text-brand">perico@grupoaguilar.com.mx</a>
          </div>
        </div>

        <div class="flex gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="flex h-11 w-11 items-center justify-center border border-panel-border text-ink transition-colors hover:border-brand hover:text-brand"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={social.path} />
              </svg>
            </a>
          ))}
        </div>

        <iframe
          title="Ubicación de Grupo Corporativo Aguilar en Veracruz"
          src={mapSrc}
          class="h-72 w-full border border-panel-border sm:h-80"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const statusEl = document.getElementById("form-status") as HTMLElement;
  const submitBtn = document.getElementById("form-submit") as HTMLButtonElement;

  const fields = ["name", "phone", "email", "message"] as const;

  function validators(el: HTMLInputElement | HTMLTextAreaElement): string {
    if (!el.value.trim()) return "Este campo es obligatorio.";
    if (el.type === "email" && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value)) {
      return "Ingresa un correo válido.";
    }
    if (el.type === "tel" && el.value.replace(/\D/g, "").length < 10) {
      return "Ingresa un teléfono a 10 dígitos.";
    }
    return "";
  }

  function validateField(name: (typeof fields)[number]) {
    const el = document.getElementById(name) as HTMLInputElement | HTMLTextAreaElement;
    const errorEl = document.getElementById(`${name}-error`) as HTMLElement;
    const message = validators(el);
    if (message) {
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
      el.classList.add("border-red-500");
    } else {
      errorEl.textContent = "";
      errorEl.classList.add("hidden");
      el.classList.remove("border-red-500");
    }
    return !message;
  }

  fields.forEach((name) => {
    const el = document.getElementById(name) as HTMLInputElement | HTMLTextAreaElement;
    el.addEventListener("blur", () => validateField(name));
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const allValid = fields.map(validateField).every(Boolean);
    if (!allValid) {
      statusEl.textContent = "Revisa los campos marcados antes de continuar.";
      return;
    }

    submitBtn.disabled = true;
    statusEl.textContent = "Enviando…";

    // TODO: connect real form submission here (email service / backend
    // endpoint). This pass only validates client-side and simulates the
    // request so the UI/UX is ready to wire up.
    window.setTimeout(() => {
      submitBtn.disabled = false;
      statusEl.textContent = "¡Gracias! Recibimos tu mensaje y te contactaremos pronto.";
      form.reset();
    }, 700);
  });
</script>
