---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const projects = [
  {
    badge: "PROYECTO EJECUTIVO",
    title: "Planeación técnica y proyecto ejecutivo",
    image: `${base}images/proyectos/proyecto-planeacion-topografica.jpg`,
    alt: "Ingenieros de Grupo Aguilar revisando un plano de proyecto ejecutivo sobre una mesa de trabajo",
  },
  {
    badge: "URBANIZACIÓN",
    title: "Urbanización y obra civil de gran escala",
    image: `${base}images/proyectos/proyecto-obra-urbanizacion-aerea.jpg`,
    alt: "Vista aérea de una obra de urbanización con cuadrillas de trabajo en sitio",
  },
  {
    badge: "SUPERVISIÓN",
    title: "Supervisión y control de obra en campo",
    image: `${base}images/proyectos/proyecto-personal-campo.jpg`,
    alt: "Supervisor de obra de Grupo Aguilar en campo durante recorrido de inspección",
  },
  {
    badge: "ELÉCTRICO",
    title: "Instalación y mantenimiento eléctrico industrial",
    image: `${base}images/proyectos/proyecto-instalacion-electrica.jpg`,
    alt: "Técnico electricista de Ingeniería Perico realizando mantenimiento a un tablero industrial",
  },
];
---

<section id="proyectos" class="bg-dark px-6 py-20 sm:px-8 sm:py-24 lg:px-12">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <h2 class="font-display text-[clamp(2rem,4.5vw,3.25rem)] font-bold leading-[1.05] text-white">
          Proyectos que construyen resultados.
        </h2>
        <p class="mt-4 text-lg text-white/70">
          Del proyecto ejecutivo a la puesta en marcha: así construimos infraestructura en todo
          Veracruz.
        </p>
      </div>
      <a
        href="#contacto"
        class="inline-flex shrink-0 items-center gap-2 bg-white px-6 py-3 text-sm font-semibold uppercase tracking-wide text-dark transition-colors hover:bg-white/90"
      >
        Ver todos
      </a>
    </div>

    <div class="relative mt-12">
      <div
        id="projects-track"
        class="scrollbar-none flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-2"
        role="region"
        aria-label="Carrusel de proyectos"
      >
        {projects.map((project) => (
          <article class="project-card w-[82%] shrink-0 snap-start sm:w-[46%] lg:w-[31.5%]">
            <div class="aspect-[4/5] overflow-hidden sm:aspect-[3/4]">
              <img
                src={project.image}
                alt={project.alt}
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="mt-4">
              <span class="inline-block bg-brand px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
                {project.badge}
              </span>
              <h3 class="mt-3 font-display text-xl font-bold text-white">{project.title}</h3>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-8 flex items-center justify-between">
        <div class="flex gap-2">
          <button type="button" id="projects-prev" aria-label="Proyecto anterior" class="carousel-arrow-btn">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button type="button" id="projects-next" aria-label="Siguiente proyecto" class="carousel-arrow-btn">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
        <div id="projects-dots" class="flex items-center gap-2.5" role="tablist" aria-label="Seleccionar proyecto"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .scrollbar-none {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }

  .carousel-arrow-btn {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(255 255 255 / 0.4);
    color: white;
    transition: background-color 200ms ease, border-color 200ms ease;
  }
  .carousel-arrow-btn:hover {
    background-color: rgb(255 255 255 / 0.12);
    border-color: rgb(255 255 255 / 0.7);
  }

  .project-dot {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.6);
    background-color: transparent;
    transition: background-color 200ms ease, transform 200ms ease;
  }
  .project-dot[aria-selected="true"] {
    background-color: white;
    transform: scale(1.15);
  }
</style>

<script>
  const track = document.getElementById("projects-track") as HTMLElement;
  const prevBtn = document.getElementById("projects-prev") as HTMLButtonElement;
  const nextBtn = document.getElementById("projects-next") as HTMLButtonElement;
  const dotsWrap = document.getElementById("projects-dots") as HTMLElement;
  const cards = Array.from(track.querySelectorAll<HTMLElement>(".project-card"));

  function cardsPerView() {
    if (window.innerWidth >= 1024) return 3;
    if (window.innerWidth >= 640) return 2;
    return 1;
  }

  function pageCount() {
    return Math.max(1, cards.length - cardsPerView() + 1);
  }

  function buildDots() {
    dotsWrap.innerHTML = "";
    const pages = pageCount();
    for (let i = 0; i < pages; i++) {
      const dot = document.createElement("button");
      dot.type = "button";
      dot.className = "project-dot";
      dot.setAttribute("role", "tab");
      dot.setAttribute("aria-label", `Ir al proyecto ${i + 1}`);
      dot.setAttribute("aria-selected", i === 0 ? "true" : "false");
      dot.addEventListener("click", () => scrollToCard(i));
      dotsWrap.appendChild(dot);
    }
  }

  function currentIndex() {
    if (!cards.length) return 0;
    const cardWidth = cards[0].offsetWidth + 20; // gap-5
    return Math.round(track.scrollLeft / cardWidth);
  }

  function scrollToCard(index: number) {
    const clamped = Math.max(0, Math.min(index, cards.length - 1));
    const card = cards[clamped];
    if (!card) return;
    track.scrollTo({ left: card.offsetLeft - track.offsetLeft, behavior: "smooth" });
  }

  function updateDots() {
    const idx = Math.min(currentIndex(), pageCount() - 1);
    dotsWrap.querySelectorAll(".project-dot").forEach((dot, i) => {
      dot.setAttribute("aria-selected", i === idx ? "true" : "false");
    });
  }

  prevBtn.addEventListener("click", () => scrollToCard(currentIndex() - 1));
  nextBtn.addEventListener("click", () => scrollToCard(currentIndex() + 1));
  track.addEventListener("scroll", () => window.requestAnimationFrame(updateDots), { passive: true });
  window.addEventListener("resize", () => {
    buildDots();
    updateDots();
  });

  buildDots();
</script>
