---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

interface Company {
  id: string;
  eyebrow: string;
  name: string;
  logo: string;
  logoAlt: string;
  logoClass: string;
  description: string;
  points: string[];
  ctaLabel: string;
  blobClass: string;
}

const companies: Company[] = [
  {
    id: "perico",
    eyebrow: "Ingeniería",
    name: "Ingeniería Perico",
    logo: `${base}images/empresas/logo-perico.png`,
    logoAlt: "Logotipo de Ingeniería Perico",
    logoClass: "h-12 sm:h-14",
    description:
      "Proyectos eléctricos, electromecánicos, civiles y de urbanización — de la subestación a la ciudad.",
    points: [
      "Infraestructura eléctrica MT/BT",
      "Obra electromecánica industrial",
      "Obra civil y urbanización",
    ],
    ctaLabel: "Ver servicios de Perico",
    blobClass: "bg-perico-tint",
  },
  {
    id: "agca",
    eyebrow: "Desarrollo Inmobiliario",
    name: "AGCA",
    logo: `${base}images/empresas/agca.jpg`,
    logoAlt: "Logotipo de Desarrollo Inmobiliario AGCA",
    logoClass: "h-20 sm:h-24",
    description:
      "Fraccionamientos, plazas y edificación vertical — desarrollo inmobiliario respaldado por capacidad técnica propia.",
    points: [
      "Desarrollo residencial y urbanización",
      "Infraestructura para vivienda a escala",
      "Plazas y edificación vertical",
    ],
    ctaLabel: "Ver desarrollo AGCA",
    blobClass: "bg-agca-tint",
  },
];
---

<section id="empresas" class="bg-brand-tint px-6 py-20 sm:px-8 sm:py-24 lg:px-12">
  <div class="mx-auto max-w-7xl">
    <p class="reveal-item flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-brand">
      <span aria-hidden="true">—</span> Lo que hacemos
    </p>
    <h2 class="reveal-item mt-4 max-w-3xl font-display text-[clamp(2.25rem,5vw,3.75rem)] font-bold leading-[1.05] text-brand">
      La misma exigencia técnica, en cada proyecto.
    </h2>

    <div class="mt-14 grid gap-6 lg:grid-cols-2 lg:gap-8">
      {companies.map((company) => (
        <article class="reveal-item relative flex h-full flex-col overflow-hidden rounded-[24px] bg-white p-10 shadow-lg shadow-brand-ink/5 sm:p-12">
          <div
            class={`pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full ${company.blobClass}`}
            aria-hidden="true"
          >
          </div>

          <div class="relative flex flex-1 flex-col">
            <div class="flex h-20 items-start sm:h-24">
              <img
                src={company.logo}
                alt={company.logoAlt}
                class={`w-auto max-w-[220px] object-contain object-left ${company.logoClass}`}
                loading="lazy"
              />
            </div>
            <p class="mt-8 text-xs font-semibold uppercase tracking-[0.2em] text-brand">{company.eyebrow}</p>
            <h3 class="mt-2 font-display text-3xl font-bold text-ink sm:text-4xl">{company.name}</h3>
            <p class="mt-4 text-base leading-relaxed text-muted">{company.description}</p>

            <ul class="mt-8 border-t border-panel-border">
              {company.points.map((point) => (
                <li class="flex items-start gap-3 border-b border-panel-border py-3.5 text-sm text-ink">
                  <span class="mt-2.5 h-px w-4 shrink-0 bg-brand" aria-hidden="true"></span>
                  {point}
                </li>
              ))}
            </ul>

            <a
              href={`${base}#${company.id}`}
              class="mt-auto inline-flex w-fit items-center gap-1.5 pt-6 text-sm font-semibold text-brand transition-colors hover:text-brand-deep"
            >
              {company.ctaLabel}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
