---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  robots?: string;
}

const {
  title,
  description = "Grupo Corporativo Aguilar: ingeniería eléctrica, civil y electromecánica con Ingeniería Perico, y desarrollo inmobiliario con AGCA. Más de 40 años en Veracruz, certificados ISO 9001:2015.",
  ogImage,
  ogImageAlt = "Grupo Corporativo Aguilar — ingeniería, infraestructura y desarrollo inmobiliario en Veracruz",
  robots = "index, follow",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const siteUrl = "https://publifix.github.io/grupo-aguilar/";
const canonicalUrl = new URL(Astro.url.pathname.replace(import.meta.env.BASE_URL, ""), siteUrl).toString();
const resolvedOgImage = new URL(ogImage ?? `${base}images/og-image.jpg`, Astro.site ?? siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  "@id": `${siteUrl}#organization`,
  name: "Grupo Corporativo Aguilar",
  alternateName: "Ingeniería Perico",
  description:
    "Grupo Aguilar es una empresa constituida en Veracruz, con el propósito de brindar servicios de ingeniería de alta calidad y desarrollo inmobiliario. Especialistas en la proyección, construcción y dirección de obra electromecánica y de urbanización a través de Ingeniería Perico, y en desarrollo de fraccionamientos y edificación a través de AGCA.",
  url: siteUrl,
  logo: new URL(`${base}images/logo-grupo-aguilar.png`, siteUrl).toString(),
  image: resolvedOgImage,
  telephone: "+522292020532",
  email: "perico@grupoaguilar.com.mx",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Francisco J. Mina 191, Col. R. Flores Magón",
    addressLocality: "Veracruz",
    addressRegion: "Veracruz",
    postalCode: "91900",
    addressCountry: "MX",
  },
  areaServed: "Veracruz, México",
  foundingDate: "1986",
  sameAs: [
    "https://www.facebook.com/GrupoCorporativoAguilar",
    "https://x.com/GrupoAguilarGCA",
    "https://www.instagram.com/grupoaguilargca/",
    "https://www.linkedin.com/company/grupo-corporativo-aguilar/",
  ],
  department: [
    {
      "@type": "Organization",
      name: "Ingeniería Perico",
      description: "Ingeniería eléctrica, electromecánica y civil desde 1986.",
      url: `${siteUrl}#perico`,
    },
    {
      "@type": "Organization",
      name: "AGCA Desarrollo Inmobiliario",
      description: "Fraccionamientos, plazas y edificación vertical en Veracruz.",
      url: `${siteUrl}#agca`,
    },
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios de ingeniería y desarrollo inmobiliario",
    itemListElement: [
      "Proyectos eléctricos integrales",
      "Alumbrado y sistemas inteligentes",
      "Instalaciones y mantenimiento electromecánico",
      "Obra civil, mecánica y estructural",
      "Estudios y pruebas especializadas",
      "Urbanización: electrificación, drenaje y agua potable",
      "Desarrollo inmobiliario residencial y comercial (AGCA)",
    ].map((name) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name },
    })),
  },
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="theme-color" content="#ffffff" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Grupo Corporativo Aguilar" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@GrupoAguilarGCA" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
